NODE_ENV=development
PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
GOOGLE_CLOUD_PROJECT=gestion-alumnos-fp-zgz
FIREBASE_DATABASE_URL=https://gestion-alumnos-fp-zgz.europe-west1.firebasedatabase.app
ATTACHMENTS_BUCKET=gestion-alumnos-fp-zgz-attachments
IAP_AUDIENCE=/projects/271453855324/locations/europe-west1/services/student-manager-zgz
# Production uses the Cloud Run service account (ADC), never a committed JSON key.

# Gmail OAuth credentials and refresh token live in Secret Manager, not here.
MAIL_SENDER=thepowerfpzaragoza@thepower.education
MAIL_ENABLED=false

# Separate external portal: ACCESS_MODE=portal; omit IAP_AUDIENCE there.
ACCESS_MODE=staff
PORTAL_URL=https://student-manager-portal-271453855324.europe-west1.run.app
# PORTAL_AUTH_SECRET is injected from Secret Manager in the portal service only.
